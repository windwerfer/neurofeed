{
    // Rust + Android container for this repo. No Flutter SDK.
    // First start, from the repo root:
    //   bash .devcontainer_rs/post-setup.sh
    //   bash .devcontainer_rs/rust-setup.sh
    //   bash .devcontainer_rs/android-setup.sh
    //   bash .devcontainer_rs/verify-setup.sh
    // Optional shell tools: bash .devcontainer_rs/quality_of_life.sh
    // Home is the volume neurofeed_home, separate from the Flutter container.
    // /opt/backups is the shared cache, so the Android cmdline-tools zip is reused.
    "name": "neurofeed",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "mounts": [
        {
            "type": "volume",
            "source": "neurofeed_home",
            "target": "/home/vscode"
        },
        {
            "type": "volume",
            "source": "shared_backups",
            "target": "/opt/backups"
        }
    ],
    "remoteUser": "vscode",
    "containerUser": "vscode",
    "updateRemoteUserUID": true,
    "runArgs": [
        "--userns=keep-id:uid=1000,gid=1000",
        "--name",
        "neurofeed",

        // pass usb into container (for adb, if you dont forward adb from the host with: 'adb -a nodaemon server start')
        // "--privileged",
        // "-v", "/dev/bus/usb:/dev/bus/usb",

        // pass bluetooth into the container
        "--net=host",
        "-v", "/var/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket",

        // pass wayland into the container
        "--device", "/dev/dri",
        "-v", "${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY}:/tmp/${localEnv:WAYLAND_DISPLAY}",
        "-v", "${localEnv:XDG_RUNTIME_DIR}/bus:/tmp/user_bus",
        "-e", "WAYLAND_DISPLAY=${localEnv:WAYLAND_DISPLAY}",
        "-e", "XDG_RUNTIME_DIR=/tmp",
        "-e", "DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/user_bus",

        // fix: if display 1 is not found (is rm after restart)
        // ln -sf $XDG_RUNTIME_DIR/wayland-1 $XDG_RUNTIME_DIR/wayland-0

        // Mount host's PulseAudio / PipeWire-Pulse socket into the container
        "-v", "${localEnv:XDG_RUNTIME_DIR}/pulse/native:/tmp/pulse-socket:ro",

        // respect timezone of host
        "-v", "/etc/localtime:/etc/localtime:ro",
        // "-v", "/etc/timezone:/etc/timezone:ro"
    ],
    "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
    },
    "containerEnv": {
        "HOME": "/home/vscode",
        "UV_CACHE_DIR": "/home/vscode/.cache/uv",
        "DEBUGPY_PROCESS_SPAWN_TIMEOUT": "90",
        "ANDROID_ADB_SERVER_ADDRESS": "127.0.0.1",
        "VIRTUAL_ENV": "/workspaces/neurofeed/.venv",
        "ANDROID_HOME": "/home/vscode/android-sdk",
        "ANDROID_SDK_ROOT": "/home/vscode/android-sdk",
        "ANDROID_NDK_HOME": "/home/vscode/android-sdk/ndk/27.2.12479018",
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64",
        "PULSE_SERVER": "unix:/tmp/pulse-socket"
    },
    // debugpy. With --net=host, trunk's 8080 is already on the host.
    // "forwardPorts": [5678],
    "customizations": {
        "zed": {}
    }
}
