{
  "mcpServers": {
    "neurofeed": {
      "command": "${workspaceFolder}/target/release/neurofeed-cli",
      "args": ["--bridge", "mcp"]
    },
    "neurofeed-headless": {
      "command": "cargo",
      "args": ["run", "-q", "--release", "-p", "neurofeed-cli", "--bin", "neurofeed-cli", "--", "--no-hardware", "--manual-clock", "mcp"]
    }
  }
}
